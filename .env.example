# ══════════════════════════════════════════════════════════════════════
# cartola-odds — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════

# ── OBRIGATÓRIO ───────────────────────────────────────────────────────
# Chave da The Odds API — obtenha grátis em https://the-odds-api.com
ODDS_API_KEY=SUA_API_KEY_AQUI

# ── PORTA DA APLICAÇÃO (opcional, padrão: 8080) ───────────────────────
APP_PORT=8080

# ── REGRAS DE NEGÓCIO (opcional) ─────────────────────────────────────
# Odd máxima para considerar um time favorito (padrão: 3.0)
CARTOLA_ODD_LIMITE=3.0

# ── PESOS DO SCORE (opcional, devem somar 1.0) ────────────────────────
CARTOLA_SCORE_PESO_MEDIA_PONTOS=0.40
CARTOLA_SCORE_PESO_VALORIZACAO=0.20
CARTOLA_SCORE_PESO_DESEMPENHO=0.20
CARTOLA_SCORE_PESO_FATOR_CASA=0.10
CARTOLA_SCORE_PESO_TIME_FAVORITO=0.10

# ── SPRING (opcional) ─────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=default
